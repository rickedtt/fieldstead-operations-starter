{
  "name": "fieldstead-operations-starter",
  "version": "0.2.45",
  "private": true,
  "description": "Fieldstead Systems internal Operations Starter dogfood system.",
  "author": "Fieldstead Systems",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run desktop:prepare-server && npm run package:validate && electron-builder --dir",
    "desktop:dist:win": "npm run desktop:prepare-server && npm run package:validate && electron-builder --win nsis --x64 && npm run installer:verify",
    "desktop:validate": "npm run package:validate",
    "icon:generate": "node scripts/generate-windows-icon.mjs",
    "icon:validate": "node scripts/validate-windows-icon.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release --ignore-pattern .hermes-tmp",
    "package:validate": "npm run icon:validate && node scripts/validate-desktop-package.mjs && npm pack --dry-run",
    "installer:verify": "node scripts/verify-windows-installer.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "desktop:dist:portable": "npm run desktop:prepare-server && npm run package:validate && electron-builder --win portable --x64",
    "desktop:publish:hq": "npm run desktop:dist:win && electron-builder --win portable --x64 && node scripts/publish-windows-demo-to-hq.mjs",
    "desktop:prepare-server": "npm run build && node scripts/prepare-desktop-runtime.mjs && npm install --omit=dev --prefix dist/standalone react@19.2.8 react-dom@19.2.8 vinext@1.0.0-beta.3",
    "desktop:dist:all": "npm run desktop:prepare-server && electron-builder --linux AppImage --win nsis --x64"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "electron-updater": "^6.8.9",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "next": "^16.3.3",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "1.0.0-beta.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260925.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.4",
    "node-addon-api": "8.5.0",
    "node-gyp": "11.4.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  },
  "type": "module",
  "build": {
    "appId": "com.fieldstead.operations.starter",
    "productName": "Fieldstead Systems Operations Starter",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "lib/mail-provider-runtime.mjs",
      "package.json",
      "!electron/**/*.test.*",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*",
      "node_modules/argparse/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/imapflow/**/*",
      "node_modules/nodemailer/**/*",
      "node_modules/mailparser/**/*",
      "node_modules/@zone-eu/**/*",
      "node_modules/encoding-japanese/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/libbase64/**/*",
      "node_modules/libmime/**/*",
      "node_modules/libqp/**/*",
      "node_modules/pino/**/*",
      "node_modules/socks/**/*",
      "node_modules/he/**/*",
      "node_modules/html-to-text/**/*",
      "node_modules/linkify-it/**/*",
      "node_modules/punycode.js/**/*",
      "node_modules/tlds/**/*",
      "node_modules/safer-buffer/**/*",
      "node_modules/atomic-sleep/**/*",
      "node_modules/on-exit-leak-free/**/*",
      "node_modules/pino-abstract-transport/**/*",
      "node_modules/pino-std-serializers/**/*",
      "node_modules/process-warning/**/*",
      "node_modules/quick-format-unescaped/**/*",
      "node_modules/real-require/**/*",
      "node_modules/safe-stable-stringify/**/*",
      "node_modules/@pinojs/**/*",
      "node_modules/sonic-boom/**/*",
      "node_modules/thread-stream/**/*",
      "node_modules/ip-address/**/*",
      "node_modules/smart-buffer/**/*",
      "node_modules/@selderee/**/*",
      "node_modules/deepmerge-ts/**/*",
      "node_modules/dom-serializer/**/*",
      "node_modules/htmlparser2/**/*",
      "node_modules/selderee/**/*",
      "node_modules/uc.micro/**/*",
      "node_modules/split2/**/*",
      "node_modules/domelementtype/**/*",
      "node_modules/domhandler/**/*",
      "node_modules/entities/**/*",
      "node_modules/domutils/**/*",
      "node_modules/parseley/**/*",
      "node_modules/leac/**/*",
      "node_modules/peberminta/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Fieldstead.Systems.Operations.Starter-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "rickedtt",
      "repo": "fieldstead-operations-starter",
      "releaseType": "release",
      "private": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fieldstead.Systems.Operations.Starter-${version}-${arch}.${ext}"
    }
  }
}
